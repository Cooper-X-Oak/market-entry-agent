{
  "name": "@imea/database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" }, "./schema": { "types": "./dist/schema/index.d.ts", "import": "./dist/schema/index.js", "default": "./dist/schema/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:bootstrap": "tsx src/bootstrap.ts",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@imea/contracts": "workspace:*",
    "@imea/domain": "workspace:*",
    "argon2": "^0.44.0",
    "drizzle-orm": "^0.44.5",
    "postgres": "^3.4.7"
  },
  "devDependencies": { "@testcontainers/postgresql": "^11.5.1", "drizzle-kit": "^0.31.4" }
}
