{
  "name": "industrial-market-entry-agent",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:workflow": "turbo run test:workflow",
    "test:e2e": "turbo run test:e2e",
    "infra:up": "docker compose up -d postgres temporal temporal-ui minio",
    "infra:down": "docker compose down",
    "db:migrate": "pnpm --filter @imea/database db:migrate",
    "db:generate": "pnpm --filter @imea/database db:generate",
    "db:bootstrap": "pnpm --filter @imea/database db:bootstrap",
    "db:seed": "pnpm --filter @imea/database db:seed"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "3.2.4",
    "@eslint/js": "^9.34.0",
    "@types/node": "^22.17.0",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.4",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "3.2.4"
  }
}
