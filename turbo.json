{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "cache": false
    },
    "test:workflow": {
      "cache": false
    },
    "test:e2e": {
      "cache": false,
      "env": ["E2E_BASE_URL", "E2E_NO_WEB_SERVER", "PLAYWRIGHT_BROWSERS_PATH"]
    }
  }
}
